# Decision Tree Implementation

# Training data
data = [
    [25, "Yes", "No"],
    [30, "Yes", "No"],
    [35, "No", "Yes"],
    [40, "No", "Yes"],
    [45, "No", "Yes"],
    [50, "Yes", "No"]
]

# Simple decision tree
def decision_tree(age, income_high):
    if age <= 32:
        return "Buy"
    else:
        if income_high == "Yes":
            return "Buy"
            
        else:
            return "Don't Buy"


print("DECISION TREE")
print("-------------")

# Test cases
test_data = [
    [28, "Yes"],
    [35, "No"],
    [45, "No"],
    [50, "Yes"]
]

for age, income in test_data:
    result = decision_tree(age, income)

    print("Age:", age)
    print("Income High:", income)
    print("Prediction:", result)
    print()
