def is_safe(board, row, col):
    for i in range(row):
        if board[i] == col or abs(board[i] - col) == abs(i - row):
            return False
    return True


def solve(board, row):
    if row == 8:
        print_board(board)
        return True

    for col in range(8):
        if is_safe(board, row, col):
            board[row] = col
            if solve(board, row + 1):
                return True
            board[row] = -1

    return False


def print_board(board):
    for row in board:
        print(" ".join("Q" if i == row else "." for i in range(8)))


board = [-1] * 8
solve(board, 0)
