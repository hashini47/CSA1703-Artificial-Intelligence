from sklearn.tree import DecisionTreeClassifier

# Training data
X = [
    [25, 1],
    [30, 1],
    [35, 0],
    [40, 0],
    [45, 0],
    [50, 1]
]

# 1 = Buy, 0 = Don't Buy
y = [1, 1, 1, 0, 0, 0]

# Create Decision Tree
model = DecisionTreeClassifier(criterion="entropy")

# Train the model
model.fit(X, y)

# Test data
test_data = [
    [32, 1],
    [42, 0],
    [28, 1],
    [48, 0]
]

# Predict
predictions = model.predict(test_data)

print("Decision Tree Predictions:")
print("--------------------------")

for i in range(len(test_data)):
    if predictions[i] == 1:
        result = "Buy"
    else:
        result = "Don't Buy"

    print(
        "Age =", test_data[i][0],
        ", Income High =", test_data[i][1],
        "=>", result
    )
    
