from sklearn.tree import DecisionTreeClassifier
from sklearn import tree

# Training data
X = [
    [25, 1],
    [30, 1],
    [35, 0],
    [40, 0],
    [45, 0],
    [50, 1]
]

# 1 = Buy, 0 = Don't Buy
y = [1, 1, 1, 0, 0, 0]

model = DecisionTreeClassifier(criterion="entropy")
model.fit(X, y)

# Prediction
age = 32
income_high = 1

prediction = model.predict([[age, income_high]])

if prediction[0] == 1:
    print("Prediction: Buy")
else:
    print("Prediction: Don't Buy")

# Display tree
tree.plot_tree(
    model,
    feature_names=["Age", "Income High"],
    class_names=["Don't Buy", "Buy"],
    filled=True
)
