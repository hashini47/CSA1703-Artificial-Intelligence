from collections import deque

def valid(m_left, c_left):
    m_right = 3 - m_left
    c_right = 3 - c_left

    if m_left < 0 or c_left < 0 or m_right < 0 or c_right < 0:
        return False

    if m_left > 0 and m_left < c_left:
        return False

    if m_right > 0 and m_right < c_right:
        return False

    return True


def solve():
    start = (3, 3, 0)
    goal = (0, 0, 1)

    moves = [(1,0), (2,0), (0,1), (0,2), (1,1)]

    queue = deque([(start, [])])
    visited = set()

    while queue:
        state, path = queue.popleft()

        if state in visited:
            continue

        visited.add(state)
        path = path + [state]

        if state == goal:
            print("Solution:")
            for s in path:
                print(s)
            return

        m, c, boat = state

        for dm, dc in moves:
            if boat == 0:
                new_state = (m-dm, c-dc, 1)
            else:
                new_state = (m+dm, c+dc, 0)

            if valid(new_state[0], new_state[1]):
                queue.append((new_state, path))


solve()
